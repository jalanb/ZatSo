The zatso.parsers package
=========================

    >>> from zatso import parsers

    >>> from pysyte.types import paths

    >>> path_to_package = paths.path(parsers).parent
    >>> path_to_bash_source = path_to_package / 'test/bash.sh'
    >>> zatso_bash = parsers.bash.parse(path_to_bash_source)
    >>> assert zatso_bash

