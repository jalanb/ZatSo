
    >>> from zatso.upgoers import readability
    >>> assert 'readability scores' in readability.__doc__

    >>> doc = readability.nlp("I am some really difficult text to read because I use obnoxiously large words.")
    >>> assert doc._.flesch_kincaid_grade_level < 16
    >>> assert doc._.flesch_kincaid_reading_ease < 64
    >>> assert doc._.dale_chall < 8

    >>> doc = readability.nlp("Hello World")
    >>> assert doc._.flesch_kincaid_grade_level < 4
    >>> assert doc._.flesch_kincaid_reading_ease < 128
    >>> assert doc._.dale_chall < 1
